{
  "name": "guiyuannew",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "src",
    "tools"
  ],
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "setup:hooks": "git config core.hooksPath .githooks",
    "prepare": "npm run --silent setup:hooks || true",
    "check:quick": "npm run fmt:check && npm run lint && npm run check:boundary && npm run check:deps",
    "verify": "npm run check:quick && npm run typecheck && npm run test && npm run check:artifact",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/core src/adapters src/minigame tools tests/core scripts",
    "fmt": "oxfmt --write \"**/*.{ts,mts,cts,js,mjs,cjs}\"",
    "fmt:check": "oxfmt --check \"**/*.{ts,mts,cts,js,mjs,cjs}\"",
    "check:deps": "depcruise --config .dependency-cruiser.js src tools",
    "check:boundary": "node scripts/check-package-boundary.mjs",
    "check:artifact": "node scripts/check-minigame-artifact.mjs",
    "benchmark:headless": "npx tsx tools/HeadlessBenchmark.ts",
    "benchmark:experiment": "npx tsx tools/ExperimentRunner.ts",
    "benchmark:head-to-head": "npx tsx tools/ExperimentRunner.ts --scan head-to-head",
    "benchmark:atk-marginal": "npx tsx tools/AtkMarginalReturn.ts",
    "benchmark:action-value-census": "npx tsx tools/ActionValueCensusCli.ts",
    "benchmark:candidate-validation": "npx tsx tools/CandidateValidationCli.ts",
    "benchmark:board-only": "npx tsx tools/ExperimentRunner.ts --scan head-to-head --mode board-only",
    "benchmark:board-value": "npx tsx tools/ExperimentRunner.ts --scan head-to-head --mode both",
    "benchmark:dynamic-switching": "npx tsx tools/DynamicSwitching.ts",
    "build:minigame": "node scripts/build-minigame.mjs",
    "dev:minigame": "node scripts/build-minigame.mjs --watch",
    "mutation": "stryker run",
    "mutation:milestone": "npm run mutation && npm run mutation:check",
    "mutation:changed": "node scripts/mutation-changed.mjs",
    "mutation:baseline": "node scripts/mutation-baseline.mjs",
    "mutation:check": "node scripts/mutation-check.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.4",
    "agent-browser": "^0.38.2",
    "dependency-cruiser": "^18.5.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "patch-package": "^8.0.1",
    "terser": "^5.46.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  }
}
