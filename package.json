{
  "name": "guiyuannew",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/core src/adapters tests/core",
    "check:lint": "oxlint src/core src/adapters tests/core",
    "oxlint": "oxlint src/core src/adapters tests/core",
    "check:deps": "depcruise --config .dependency-cruiser.js src",
    "benchmark:headless": "npx tsx src/core/headless/HeadlessBenchmark.ts",
    "benchmark:experiment": "npx tsx src/core/headless/ExperimentRunner.ts",
    "benchmark:head-to-head": "npx tsx src/core/headless/ExperimentRunner.ts --scan head-to-head",
    "benchmark:atk-marginal": "npx tsx src/core/headless/AtkMarginalReturn.ts",
    "benchmark:board-only": "npx tsx src/core/headless/ExperimentRunner.ts --scan head-to-head --mode board-only",
    "benchmark:board-value": "npx tsx src/core/headless/ExperimentRunner.ts --scan head-to-head --mode both",
    "benchmark:dynamic-switching": "npx tsx src/core/headless/DynamicSwitching.ts",
    "build:minigame": "node scripts/build-minigame.mjs",
    "dev:minigame": "node scripts/build-minigame.mjs --watch",
    "stryker": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.4",
    "agent-browser": "^0.38.2",
    "dependency-cruiser": "^18.5.0",
    "oxlint": "^1.87.0",
    "terser": "^5.46.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.3"
  }
}
